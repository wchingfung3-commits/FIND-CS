{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint && npm run test:data && npm run validate:data && npm run test:agents && npm run test:auth && npm run test:pagination && npm run test:db && npm run test:providers && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:admin": "node scripts/admin-smoke.mjs",
    "test:pagination": "vite build --ssr scripts/test-admin-pagination.ts --outDir .pagination-build --emptyOutDir && node .pagination-build/test-admin-pagination.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:data": "vite build --ssr scripts/test-data.ts --outDir .test-build --emptyOutDir && node .test-build/test-data.js",
    "test:db": "node scripts/test-db.mjs",
    "validate:data": "vite build --ssr scripts/validate-data.ts --outDir .validation-build --emptyOutDir && node .validation-build/validate-data.js",
    "test:auth": "vite build --ssr scripts/test-admin-auth.ts --outDir .auth-build --emptyOutDir && node .auth-build/test-admin-auth.js",
    "test:agents": "vite build --ssr scripts/test-agent-contracts.ts --outDir .agents-build --emptyOutDir && node .agents-build/test-agent-contracts.js",
    "test:admin:required": "node scripts/admin-smoke.mjs --require-browser",
    "test:providers": "node scripts/test-provider-connections.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
